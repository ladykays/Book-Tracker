
<main class="flex flex-col justify-center items-center my-10">
  <div class="flex justify-between items-center w-8/12 p-4">
    <h3 class="font-semibold text-xl w-1/3">Your Books</h3>
    <div class="flex justify-end items-center gap-8 w-2/3">
      <p class="">Sort by:</p>
      <button 
        class="sort-btn flex gap-2 px-4 py-2 rounded-lg hover:bg-gray-100 <%= (typeof currentSort !== 'undefined' && currentSort === 'recent') ? 'bg-blue-100 text-blue-700' : '' %>"
        id="sortRecent"
        data-sort="recent"
      >
        <i class="bi bi-clock"></i>
        <p>Recent</p>
      </button>
      <button 
        class="sort-btn flex gap-2 px-4 py-2 rounded-lg hover:bg-gray-100 <%= (typeof currentSort !== 'undefined' && currentSort === 'rating') ? 'bg-blue-100 text-blue-700' : '' %>"
        id="sortRating"
        data-sort="rating"
      >
        <i class="bi bi-star"></i>
        <p>Rating</p>
      </button>
      <button 
        class="sort-btn flex gap-2 px-4 py-2 rounded-lg hover:bg-gray-100 <%= (typeof currentSort !== 'undefined' && currentSort === 'title') ? 'bg-blue-100 text-blue-700' : '' %>"
        id="sortTitle"
        data-sort="title"
      >
        <i class="bi bi-sort-alpha-down"></i>
        <p>Title</p>
      </button>
    </div>
  </div>
  <% if (books && books.length > 0) { %>
    <div class="grid sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 w-8/12" id="booksContainer">
      <%- include("partials/bookCard.ejs") %> 
    </div>
  <% } else { %> 
    <%- include("noBooks.ejs") %>
  <% } %>
</main>


