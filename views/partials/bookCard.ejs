<% if (books) { %> 
  <% books.forEach((book) => { 
    console.log('Book:', book.title, 'Created at:', book.created_at, 'Type:', typeof book.created_at);

    let timestamp;
    if (book.created_at) {
      // Parse the date string from PostgreSQL
      const date = new Date(book.created_at);
      timestamp = date.getTime();
    } else {
      // Fallback: Use current time minus a random offset
      timestamp = Date.now() - Math.floor(Math.random() * 10000000000);
    }
  %>
    <div
       class="book-card flex w-full h-70 rounded-lg bg-white shadow-md overflow-hidden cursor-pointer hover:shadow-lg transition-shadow" 
       data-book="<%= JSON.stringify(book) %>"
       data-title="<%= book.title.toLowerCase() %>"
       data-rating="<%= book.rating %>"
       data-created="<%= timestamp %>"
       data-id="<%= book.id %>"
    >
      <div class="flex">
        <div  class="overflow-hidden w-2/5 flex-shrink-0">
          <img src="<%= book.cover_url %>" alt="book cover" class="w-full h-full object-cover" />
        </div>
        <div class="w-3/5 p-4">
          <h3 class="text-gray-900 line-clamp-2 text-xl font-medium "><%= book.title %></h3>
          <p class="text-sm text-gray-600 mt-1"><%= book.author %></p>
          <div class="flex items-center mt-2">
            <%- renderStars(book.rating) %>
          </div>
          <p class="text-sm text-gray-500 mt-2 line-clamp-5"><%= book.notes %></p>
          <p class="text-xs text-gray-400 mt-4">
              Added: <%= new Date(book.created_at).toLocaleDateString() %>
          </p>
        </div>
      </div>
      
    </div> 
  <% }) %>
<% } %> 

