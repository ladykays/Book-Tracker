<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Book Note Tracker</title>
    <link rel="stylesheet" href="/css/bootstrap-icons/bootstrap-icons.css" />
    <link rel="stylesheet" href="./css/output.css" />
    <!-- <link rel="stylesheet" href="./css/style.css" /> -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
    <script src="/js/addBookModal.js"></script>
    <script src="/js/bookModal.js"></script>
    <script src="/js/sortBooks.js"></script>
  </head>
  <body class="min-h-screen bg-gray-50 w-full" style="margin:0; font-family: 'inter', sans-serif;">
    <%- include("partials/header.ejs") %>

    <!-- Dynamic content -->
    <%- body %>

    <!-- Add Book Modal -->
    <div
      id="addBookModal"
      class="fixed inset-0 z-50 hidden flex items-center justify-center"
    >
      <!-- Semi-transparent overlay -->
      <div class="absolute inset-0 bg-blue-900/50" id="addModalOverlay"></div>

      <!-- BookForm Modal content -->
      <div
        class="relative z-10 bg-white rounded-xl shadow-2xl w-full max-w-2xl"
        id="addBookModalContent"
      >
        <%- include("addBookForm.ejs") %>
      </div>
    </div>

    <!-- Book Details Modal -->
    <div
      id="bookModalContainer"
      class="fixed inset-0 z-50 hidden flex items-center justify-center"
    >
      <!-- Semi-transparent overlay -->
      <div class="absolute inset-0 bg-blue-900/50" id="bookModalOverlay"></div>

      <!-- Book Details Modal content -->
      <div
        class="relative z-10 bg-white rounded-xl shadow-2xl w-full max-w-2xl"
        id="bookModalContent"
      >
        <%- include("partials/bookModal.ejs") %>
      </div>
    </div>
  </body>
</html>
