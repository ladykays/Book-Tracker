<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Book Note Tracker</title>
    <link rel="stylesheet" href="/css/bootstrap-icons/bootstrap-icons.css" />
    <link rel="stylesheet" href="./css/output.css" />
  </head>
  <body>
    <%- include("partials/header.ejs") %>

    <!-- Dynamic content -->
    <%- body %>

    <!-- Add Book Modal -->
    <div
      id="addBookModal"
      class="fixed inset-0 z-50 hidden flex items-center justify-center"
    >
      <!-- Semi-transparent overlay -->
      <div class="absolute inset-0 bg-blue-900/50" id="modalOverlay"></div>

      <!-- Modal content -->
      <div
        class="relative z-10 bg-white rounded-xl shadow-2xl w-full max-w-2xl"
        id="modalContent"
      >
        <%- include("addBookForm.ejs") %>
      </div>
    </div>

    <script>
      let modal, overlay, modalContent;

      document.addEventListener("DOMContentLoaded", function () {
        // Initialize modal elements
        modal = document.getElementById("addBookModal");
        overlay = document.getElementById("modalOverlay");
        modalContent = document.getElementById("modalContent");

        const sortButtons = document.querySelectorAll(".sort-btn");
        const booksContainer = document.getElementById("booksContainer");

        function sortBooks(sortType) {
          const bookCards = Array.from(document.querySelectorAll(".book-card"));

          if (bookCards.length === 0) return;

          bookCards.sort((a, b) => {
            switch (sortType) {
              case "recent":
                //Sort by most recent first (data-id)
                const idA = parseInt(a.getAttribute("data-id"));
                const idB = parseInt(b.getAttribute("data-id"));
                return idB -idA;


                //Sort by most recent first(data-created)
                /* const dateA = parseInt(a.getAttribute("data-created")) || 0;
                const dateB = parseInt(b.getAttribute("data-created")) || 0;
                const idA = parseInt(a.getAttribute("data-id") || 0);
                const idB = parseInt(b.getAttribute("data-id") || 0);
                console.log("Recent sort:", {
                  dateA,
                  dateB,
                  idA,
                  idB,
                  titleA: a.querySelector("h2")?.textContent,
                  titleB: b.querySelector("h2")?.textContent,
                });

                // First sort by date
                if (dateB !== dateA) {
                  return dateB - dateA; //newst first
                }

                // If dates are equal or null, sort by ID
                return idB - idA; */

              case "rating":
                //Sort by highest rating first
                const ratingA = parseFloat(a.getAttribute("data-rating")) || 0;
                const ratingB = parseFloat(b.getAttribute("data-rating")) || 0;
                console.log("Rating sort:", {
                  ratingA,
                  ratingB,
                  titleA: a.querySelector("h2")?.textContent,
                  titleB: b.querySelector("h2")?.textContent,
                });
                if (ratingB !== ratingA) {
                  return ratingB - ratingA; //highest first
                }
                //If ratings are equal, sort most recent
                return (
                  parseInt(b.getAttribute("data-created")) -
                  parseInt(a.getAttribute("data-created"))
                );

              case "title":
                //Sort alphabetically
                const titleA = a.getAttribute("data-title").toLocaleLowerCase();
                const titleB = b.getAttribute("data-title").toLocaleLowerCase();
                console.log("Title sort:", { titleA, titleB });
                return titleA.localeCompare(titleB);

              default:
                return 0;
            }
          });

          // Clear and reappend sorted cards
          booksContainer.innerHTML = "";
          bookCards.forEach((card) => {
            booksContainer.appendChild(card);
          });
        }

        //Only set up sorting if there is books
        if (booksContainer && sortButtons.length > 0) {
          //Loop through each sort button adding a click event listener to each
          sortButtons.forEach((button) => {
            button.addEventListener("click", function () {
              const sortType = this.getAttribute("data-sort"); //get the data-sort attribute value from the clicked button and assign it to sortType
              sortBooks(sortType); //call the sortBooks function with the sortType vaalue

              //Loop through all sort buttons to reset their styling
              sortButtons.forEach((btn) => {
                btn.classList.remove("bg-blue-100", "text-blue-700"); //remove active styling class
                btn.classList.add("hover:bg-gray-100"); //add default hover styling
              });
              this.classList.add("bg-blue-100", "text-blue-700"); //add active styling to currently clicked button
              this.classList.remove("hover:bg-gray-100"); //remove hover styling from active button
            });
          });

          // Initialize with recent sort on page load
          const activeButton = document.querySelector(
            '.sort-btn[data-sort="recent"]',
          );
          if (activeButton) {
            sortBooks("recent");
            activeButton.classList.add("bg-blue-100", "text-blue-700");
            activeButton.classList.remove("hover:bg-gray-100");
          }
        }

        

        //for debugging
        setTimeout(() => {
          console.log("=== Checking ALL data-created values ===");
          const cards = document.querySelectorAll(".book-card");
          cards.forEach((card, index) => {
            const title = card.querySelector("h2").textContent;
            const created = card.getAttribute("data-created");
            const date = new Date(parseInt(created));
            console.log(
              `${index + 1}. "${title.substring(0, 30)}...": ${created} = ${date.toLocaleString()}`,
            );
          });
        }, 1000);
      });
      function openBookForm() {
        modal.classList.remove("hidden");
        document.body.style.overflow = "hidden";
      }

      function closeModal() {
        modal.classList.add("hidden");
        document.body.style.overflow = "";
      }

      // Close modal when clicking overlay
      overlay.addEventListener("click", closeModal);

      // Prevent modal content clicks from closing modal
      modalContent.addEventListener("click", (e) => {
        e.stopPropagation();
      });

      // Close modal when clicking close button
      document.addEventListener("click", (e) => {
        if (
          e.target.id === "closeBtn" ||
          e.target.id === "cancelBtn" ||
          e.target.closest("#closeBtn") ||
          e.target.closest("#cancelBtn")
        ) {
          closeModal();
        }
      });
    </script>
  </body>
</html>
