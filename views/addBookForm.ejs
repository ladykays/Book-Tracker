<div class="bg-blue-50 w-full rounded-xl overflow-hidden">
  <div class="p-8">
    <div class="flex justify-between items-center">
      <h2 class="font-bold text-3xl">Add New Book</h2>
      <button 
        type="button" 
        id="closeBtn"
        onclick="closeModal()"
        class="text-gray-600 hover:text-gray-900 hover:bg-gray-200 p-2 rounded-full transition duration-200"
        aria-label="Close modal"
      >
        <i class="bi bi-x-lg"></i>
      </button>
    </div>
    <form id="addBook" method="POST" action="/" class="">
      <div class="flex flex-col pt-5">
        <label for="title">Title *</label>
        <input type="text" name="title" value="<%= locals.title %>" class="w-full bg-blue-100 p-2 rounded-lg">
      </div>
      <div class="flex flex-col pt-5">
        <label for="author">Author *</label>
        <input type="text" name="author" value="<%= locals.author %>" class="w-full bg-blue-100 p-2 rounded-lg">
      </div>
      <div class="flex flex-col pt-5">
        <label for="isbn">ISBN </label>
        <input type="text" name="isbn" value="<%=locals.isbn%>" placeholder="e.g., 9780061120084 " class="w-full bg-blue-100 p-2 rounded-lg">
      </div>
      <div class="flex flex-col pt-5">
        <label for="rating">Rating</label>
        <input type="number" name="rating" value="<%= locals.rating %>" class="w-full bg-blue-100 p-2 rounded-lg">
      </div>
      <div class="flex flex-col pt-5">
        <label for="notes">Notes</label>
        <textarea name="notes"  class="w-full bg-blue-100 p-2 rounded-lg" rows="10"><%= locals.notes %></textarea>
      </div>
      <div class="mt-8 flex justify-end gap-5">
        <button 
          type="button" class="border-2 border-gray-300 text-gray-700 rounded-lg px-8 py-3 cursor-pointer"
          onclick="closeModal()"
        >Cancel</button>
        <button 
          type="submit"
          class="bg-blue-700 text-white rounded-lg px-8 py-3 cursor-pointer"
           >Add Book</button>
      </div>
      
    </form>
  </div>
</div>
